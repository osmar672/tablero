{
  "name": "policybot-mysql-groq-drive",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "db:migrate": "npm run migrate -w backend",
    "db:seed": "npm run seed -w backend",
    "test": "npm run test -w backend",
    "smoke": "node scripts/smoke-api.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "db:doctor": "node backend/src/db/doctor.js",
    "check:concurrency": "node scripts/check-concurrency.mjs",
    "check:api": "node scripts/check-api.mjs",
    "prepare:semantic": "node scripts/prepare-semantic.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:restore": "node scripts/backup.mjs restore",
    "check:features": "node scripts/check-features.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
