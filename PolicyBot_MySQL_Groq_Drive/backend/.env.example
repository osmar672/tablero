# Desarrollo local con docker-compose.yml. No uses estos valores en producción.
PORT=4000
NODE_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=policybot
MYSQL_PASSWORD=policybot_local
MYSQL_DATABASE=policybot
# npm run setup:env genera un secreto aleatorio al crear backend/.env.
JWT_SECRET=REEMPLAZA_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
SYNC_CRON=0 * * * *
MAX_UPLOAD_MB=10
# URL pública fija para enlaces de acceso; HTTPS obligatorio en producción.
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Modelo neuronal opcional: npm run prepare:semantic y EMBEDDING_PROVIDER=transformers.
LOCAL_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# OCR requiere Tesseract y Poppler. Instala spa para usar spa+eng.
OCR_ENABLED=true
OCR_LANG=eng
# Copias cifradas: clave independiente de al menos 32 caracteres. Guárdala fuera del servidor.
BACKUP_ENCRYPTION_KEY=
# Horario UTC. Ejemplo 0 8 * * * = 02:00 de Costa Rica.
BACKUP_CRON=0 8 * * *
BACKUP_RETENTION_DAYS=14
